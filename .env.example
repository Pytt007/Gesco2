# Variables d'environnement GESCO — Production (Neon)
# Copiez ce fichier en .env.local et remplissez les valeurs.
# Ne commitez jamais .env.local dans git !

# ──────────────────────────────────────────────────────────────────────────
# NEON — Obtenez ces valeurs dans Neon > Data API / Better Auth
# ──────────────────────────────────────────────────────────────────────────
VITE_NEON_AUTH_URL=https://VOTRE_PROJET.neonauth.<region>.aws.neon.tech/<database>/auth
VITE_NEON_DATA_API_URL=https://VOTRE_PROJET.apirest.<region>.aws.neon.tech/<database>/rest/v1

# Variables serveur uniquement (Vercel Production, ne jamais exposer au navigateur)
NEON_AUTH_URL=https://VOTRE_PROJET.neonauth.<region>.aws.neon.tech/<database>/auth
NEON_AUTH_COOKIE_SECRET=generez_une_valeur_aleatoire_d_au_moins_32_caracteres
GESCO_ADMIN_EMAIL=adresse_de_recuperation@example.com

# ──────────────────────────────────────────────────────────────────────────
# GEMINI AI (optionnel — pour les fonctionnalités IA)
# ──────────────────────────────────────────────────────────────────────────
VITE_GEMINI_API_KEY=
GEMINI_API_KEY=
